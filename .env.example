# Скопируйте в .env и заполните значения
BOT_TOKEN=123456789:AA...your-token...

# CSV-файл, где хранятся записи (автоматически создаётся)
CSV_FILE=./data/bookings.csv

TIMEZONE=Europe/Moscow
WORK_START_HOUR=10
WORK_END_HOUR=22
SLOT_MINUTES=30
BOOKING_HORIZON_DAYS=7
ADMIN_SECRET=change-me

# Telegram ID администратора для уведомлений о новых записях/отменах
# (узнать свой ID можно, например, у @userinfobot; 0 — выключить)
ADMIN_CHAT_ID=0

# Услуги салона: "Название|длительность_в_минутах" через точку с запятой.
# Добавьте по аналогии «Услуга 3», «Услуга 4» и т.д., изменив названия.
SERVICES=Услуга 1|30;Услуга 2|30

# За сколько часов до визита отправлять напоминание клиенту
REMINDER_HOURS_BEFORE=3
